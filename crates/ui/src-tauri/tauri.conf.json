{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByocVPN",
  "version": "0.1.29",
  "identifier": "com.byocvpn.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByocVPN",
        "width": 1080,
        "height": 720,
        "maxWidth": 1080,
        "maxHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {}
  }
}
