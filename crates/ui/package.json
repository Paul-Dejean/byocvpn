{
  "name": "ui",
  "private": true,
  "version": "0.1.28",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "run-s --continue-on-error lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint --type-aware src",
    "lint:eslint": "eslint src",
    "lint:fix": "run-s --continue-on-error lint:fix:oxlint lint:fix:eslint",
    "lint:fix:oxlint": "oxlint --type-aware --fix src",
    "lint:fix:eslint": "eslint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check:compiler": "node scripts/check-compiler.mjs",
    "prepare": "cd ../.. && husky || true",
    "preview": "vite preview",
    "tauri": "cross-env CARGO_TARGET_DIR=../../../target/tauri tauri",
    "tauri:dev": "cargo build -p byocvpn_daemon --manifest-path ../../Cargo.toml && cross-env CARGO_TARGET_DIR=../../../target/tauri RUST_LOG_STYLE=always tauri dev",
    "tauri:build": "cross-env CARGO_TARGET_DIR=../../../target/tauri node scripts/tauri-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "@tauri-apps/plugin-store": "~2.5.0",
    "flag-icons": "^7.6.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
